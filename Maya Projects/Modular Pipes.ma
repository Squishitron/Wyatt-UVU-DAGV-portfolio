	rename -uid "BD9EC0B8-4FB7-4829-C1A2-B9A67CE1847E";
	setAttr ".ufem" -type "stringArray" 0  ;
createNode renderLayerManager -n "renderLayerManager";
	rename -uid "933AB267-4560-5F91-6591-9D81239F896C";
createNode renderLayer -n "defaultRenderLayer";
	rename -uid "038B3E5D-4795-A8FB-EA30-4C998F9D4039";
	setAttr ".g" yes;
createNode script -n "uiConfigurationScriptNode";
	rename -uid "4A98C2F1-4346-BAAC-57BB-279FE024228B";
	setAttr ".b" -type "string" (
